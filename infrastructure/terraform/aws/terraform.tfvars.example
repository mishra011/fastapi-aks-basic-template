aws_region          = "ap-south-1"
cluster_name        = "fastapi-eks"
kubernetes_version  = "1.35"
admin_principal_arn = "arn:aws:iam::123456789012:role/YourAdminRole"
# Use the exact OIDC subject prefix returned by GitHub plus the aws branch suffix.
github_oidc_subject = "repo:mishra011@11480002/fastapi-aks-basic-template@1353797397:ref:refs/heads/aws"
# If GitHub's OIDC provider already exists in this AWS account, reuse it:
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
